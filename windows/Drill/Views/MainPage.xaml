<UserControl x:Class="Drill.Views.MainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ink="clr-namespace:Drill.Ink"
             MinWidth="780" Focusable="True" FocusVisualStyle="{x:Null}"
             KeyboardNavigation.TabNavigation="Cycle">
    <!-- As MainView.swift: the header, then the stack (the timer, then your
         year) in a 700-wide column. The window is sized to the stack; any
         spare height splits 2:3 above and below it, never more than 160 above. -->
    <Grid x:Name="Root">
        <Grid x:Name="Paper" MaxWidth="700" HorizontalAlignment="Center" Margin="40,56,40,32" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="24" />
                <RowDefinition Height="2*" MaxHeight="160" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>

            <!-- Header: 24 under the title bar, links 15 with 20 between -->
            <DockPanel x:Name="Header" Grid.Row="0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,-2,0" x:Name="Links">
                    <TextBlock x:Name="Updating" Text="updating…" Style="{StaticResource Base}" FontSize="15" Opacity="0.52"
                               Margin="0,0,18,0" Visibility="Collapsed" VerticalAlignment="Center" />
                    <ink:InkLink x:Name="UpdateLink" Margin="0,0,16,0" Visibility="Collapsed" Click="OnUpdate" />
                    <ink:InkLink x:Name="SyncLink" Content="{Binding Sync.Label}" Margin="0,0,16,0" Visibility="Collapsed" Click="OnSync" />
                    <ink:InkLink Content="inspo" Margin="0,0,16,0" Click="OnInspo" />
                    <ink:InkLink Content="settings" Click="OnSettings" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Model.LastError}" Style="{StaticResource Base}" FontSize="13"
                           Opacity="0.52" Margin="0,0,18,0" VerticalAlignment="Center" />
            </DockPanel>

            <!-- The stack, 24 under the header -->
            <StackPanel x:Name="Stack" Grid.Row="2" Margin="0,24,0,0">

                <!-- The timer: ring, digits, what you're studying, and the three controls -->
                <StackPanel HorizontalAlignment="Center">
                    <!-- Everything inside the ring is sized from its diameter R (SizeRing): the
                         status word 0.055 R, the clock 0.22 R, the mark slot 0.08 R. -->
                    <Grid x:Name="Ring" Width="270" Height="270">
                        <ink:DoodleRing Progress="{Binding Model.Progress}" Boiling="{Binding Model.IsRunning}" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <ink:FadingText x:Name="Status" FontSize="15" Opacity="0.52" HorizontalAlignment="Center" Height="20" />
                            <ink:RollingText x:Name="Clock" AutomationProperties.HelpText="space or enter starts and pauses" FontSize="59" HorizontalAlignment="Center" Margin="0,8,0,11" />
                            <!-- A fixed slot for the mark under the clock, so the clock never moves. -->
                            <Grid x:Name="MarkSlot" Height="22">
                                <ink:CycleDots Filled="{Binding Model.CyclePosition}" Count="{Binding Model.CycleLength}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="32" Margin="0,40,0,0">
                        <TextBlock Text="studying" Style="{StaticResource Base}" FontSize="15" Opacity="0.52" VerticalAlignment="Bottom"
                                   Margin="0,0,8,4" />
                        <Grid Width="150">
                            <TextBlock x:Name="Hint" Text="anything" FontSize="15" Foreground="{DynamicResource Hint}"
                                       FontFamily="{DynamicResource Text}" IsHitTestVisible="False" Margin="0,0,0,4" VerticalAlignment="Bottom" />
                            <TextBox x:Name="TagBox" AutomationProperties.Name="studying" Style="{StaticResource Bare}" FontSize="15" Margin="0,0,0,4" MaxLength="40"
                                     Text="{Binding Model.Tag, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Bottom" />
                            <Rectangle x:Name="Underline" Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Ghost}" />
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="Suggestions" Orientation="Horizontal" HorizontalAlignment="Center" Height="18" Margin="58,8,0,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
                        <ink:InkLink x:Name="ResetLink" Content="reset" VerticalAlignment="Center" Margin="0,0,30,0" Click="OnReset" />
                        <ink:Capsule x:Name="Primary" Content="{Binding Model.PrimaryLabel}" Height="48" MinWidth="128" Click="OnToggle" />
                        <ink:InkLink Content="skip" VerticalAlignment="Center" Margin="30,0,0,0" Click="OnSkip" />
                    </StackPanel>
                </StackPanel>

                <!-- Your year, 56 under the controls -->
                <StackPanel Margin="0,56,0,0">
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel x:Name="Filters" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,-2,0" />
                    </DockPanel>
                    <ink:HeatGrid x:Name="Year" Heatmap="{Binding Model.Heatmap}" Margin="-3,0" />
                    <Grid Height="24" Margin="0,16,0,0" TextElement.FontSize="15">
                        <StackPanel x:Name="Stats" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Base}" Opacity="0.52" Text="today" />
                            <TextBlock Style="{StaticResource Base}" Margin="5,0,22,0" x:Name="Today" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Base}" Opacity="0.52" Text="this week" />
                            <TextBlock Style="{StaticResource Base}" Margin="5,0,22,0" x:Name="Week" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Base}" Opacity="0.52" Text="streak" />
                            <TextBlock Style="{StaticResource Base}" Margin="5,0,0,0" x:Name="Streak" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel x:Name="Legend" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" TextElement.FontSize="11">
                            <TextBlock Style="{StaticResource Base}" Opacity="0.52" Text="less" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <StackPanel x:Name="Swatches" Orientation="Horizontal" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Base}" Opacity="0.52" Text="more" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="DayCaption" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Base}" x:Name="DayName" />
                            <TextBlock Style="{StaticResource Base}" Opacity="0.52" Text=" — " />
                            <TextBlock Style="{StaticResource Base}" Opacity="0.52" x:Name="DayAmount" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
