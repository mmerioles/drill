<UserControl x:Class="Drill.Views.AccountForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ink="clr-namespace:Drill.Ink">
    <StackPanel>
        <TextBlock x:Name="Heading" Style="{StaticResource Base}" FontFamily="{DynamicResource Display}" FontWeight="SemiBold"
                   FontSize="20" TextOptions.TextFormattingMode="Ideal" Text="sign in" />
        <!-- Windows 11 fields: text from the left, a placeholder, a mark at the
             right edge, and an ink underline on the one you're typing in. -->
        <Border Margin="0,16,0,0" CornerRadius="4" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardLine}"
                BorderThickness="1" ClipToBounds="True">
            <StackPanel TextElement.FontSize="15">
                <Grid Height="44">
                    <TextBlock x:Name="EmailHint" Text="email" FontSize="15" Foreground="{DynamicResource Hint}"
                               FontFamily="{DynamicResource Text}" VerticalAlignment="Center" Margin="12,0" IsHitTestVisible="False" />
                    <TextBox x:Name="Email" AutomationProperties.Name="email" Style="{StaticResource Bare}" FontSize="15" VerticalAlignment="Center"
                             Margin="12,0,40,0" MaxLength="254" />
                    <ink:StatusMark x:Name="EmailMark" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Rectangle x:Name="EmailLine" Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource CardLine}" />
                </Grid>
                <Grid Height="44">
                    <TextBlock x:Name="PasswordHint" Text="password" FontSize="15" Foreground="{DynamicResource Hint}"
                               FontFamily="{DynamicResource Text}" VerticalAlignment="Center" Margin="12,0" IsHitTestVisible="False" />
                    <PasswordBox x:Name="Password" AutomationProperties.Name="password" Style="{StaticResource BarePassword}" FontSize="15" VerticalAlignment="Center"
                                 Margin="12,0,40,0" />
                    <ink:StatusMark x:Name="PasswordMark" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Rectangle x:Name="PasswordLine" Height="1" VerticalAlignment="Bottom" Fill="Transparent" />
                </Grid>
                <Grid x:Name="ConfirmRow" Height="44" Visibility="Collapsed">
                    <TextBlock x:Name="ConfirmHint" Text="confirm password" FontSize="15" Foreground="{DynamicResource Hint}"
                               FontFamily="{DynamicResource Text}" VerticalAlignment="Center" Margin="12,0" IsHitTestVisible="False" />
                    <PasswordBox x:Name="Confirm" AutomationProperties.Name="confirm password" Style="{StaticResource BarePassword}" FontSize="15" VerticalAlignment="Center"
                                 Margin="12,0,40,0" />
                    <ink:StatusMark x:Name="ConfirmMark" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Rectangle x:Name="ConfirmLine" Height="1" VerticalAlignment="Bottom" Fill="Transparent" />
                </Grid>
            </StackPanel>
        </Border>
        <!-- Off: the account ends when drill quits. -->
        <DockPanel Margin="0,14,0,0">
            <ink:Toggle x:Name="Stay" DockPanel.Dock="Right" IsOn="True" AutomationProperties.Name="stay signed in" VerticalAlignment="Center" />
            <TextBlock Text="stay signed in" Style="{StaticResource Base}" FontSize="15" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock x:Name="Problem" Style="{StaticResource Base}" FontSize="13" Opacity="0.52" Margin="0,10,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed" />
        <DockPanel Margin="0,24,0,0">
            <ink:InkLink x:Name="SwitchMode" VerticalAlignment="Center" Click="OnSwitch" Margin="-2,0,0,0" />
            <ink:Capsule x:Name="Primary" DockPanel.Dock="Right" FontSize="15" Height="40" Padding="32,0" Click="OnSubmit" IsDefault="True" />
            <ink:InkLink x:Name="Cancel" Content="cancel" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                         Click="OnCancel" IsCancel="True" />
            <Border />
        </DockPanel>
    </StackPanel>
</UserControl>
